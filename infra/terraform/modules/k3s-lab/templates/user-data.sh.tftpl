#!/bin/bash
# =============================================================================
# First-boot bootstrap for the single-node k3s "lab" (rendered by Terraform).
# Runs ONCE via cloud-init as root. Idempotent where practical.
# Log: /var/log/lab-bootstrap.log   Done-marker: /var/lib/lab-bootstrap.done
# =============================================================================
set -euo pipefail
exec > >(tee -a /var/log/lab-bootstrap.log) 2>&1
echo "[lab] bootstrap started $(date -Is)"

export AWS_DEFAULT_REGION="${region}"
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
export PATH="$PATH:/usr/local/bin"

# ---- 1. Swap: safety net for 2 GiB instances (dd, not fallocate: XFS + swapfile) ----------
if ! swapon --show | grep -q /swapfile; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
echo 'vm.swappiness=20' > /etc/sysctl.d/99-lab-swap.conf
sysctl -p /etc/sysctl.d/99-lab-swap.conf

# ---- 2. k3s (lean: no traefik / servicelb / metrics-server) ----------------------------------
mkdir -p /etc/rancher/k3s
cat > /etc/rancher/k3s/config.yaml <<'K3SCFG'
write-kubeconfig-mode: "0644"
disable:
  - traefik
  - servicelb
  - metrics-server
kubelet-arg:
  - "eviction-hard=memory.available<150Mi"
  - "max-pods=60"
K3SCFG

curl -sfL https://get.k3s.io | \
  INSTALL_K3S_VERSION="${k3s_version}" \
  INSTALL_K3S_SKIP_SELINUX_RPM=true \
  INSTALL_K3S_SELINUX_WARN=true \
  sh -s - server

echo "[lab] waiting for the node to become Ready"
for _ in $(seq 1 90); do
  if kubectl get nodes 2>/dev/null | grep -q " Ready"; then break; fi
  sleep 5
done
kubectl get nodes

# ---- 3. Secrets generated on the node (never stored in Terraform state / user-data) ---------
kubectl create namespace monitoring --dry-run=client -o yaml | kubectl apply -f -
GRAFANA_PW="$(openssl rand -hex 16)"
kubectl -n monitoring create secret generic grafana-admin \
  --from-literal=admin-user=admin \
  --from-literal=admin-password="$GRAFANA_PW" \
  --dry-run=client -o yaml | kubectl apply -f -
aws ssm put-parameter --name "${ssm_prefix}/grafana-admin-password" \
  --type SecureString --value "$GRAFANA_PW" --overwrite > /dev/null

# ---- 4. Argo CD -------------------------------------------------------------------------------
kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
# Server-side apply: Argo CD's CRDs exceed the 256 KiB client-side annotation limit.
kubectl apply -n argocd --server-side --force-conflicts \
  -f "https://raw.githubusercontent.com/argoproj/argo-cd/${argocd_version}/manifests/install.yaml"

# Plain HTTP behind the SSM tunnel (TLS terminates nowhere; the node has no inbound exposure).
kubectl -n argocd patch configmap argocd-cmd-params-cm --type merge -p '{"data":{"server.insecure":"true"}}'
# Save ~300 MiB: this lab uses neither SSO (dex), notifications nor ApplicationSets.
kubectl -n argocd scale deployment argocd-dex-server argocd-notifications-controller argocd-applicationset-controller --replicas=0
# NodePort 30080 — reachable only through the SSM port-forward (security group has no inbound rules).
kubectl -n argocd patch svc argocd-server --type merge \
  -p '{"spec":{"type":"NodePort","ports":[{"name":"http","port":80,"targetPort":8080,"nodePort":30080},{"name":"https","port":443,"targetPort":8080}]}}'
kubectl -n argocd rollout restart deployment argocd-server

kubectl -n argocd rollout status deployment/argocd-server --timeout=600s
kubectl -n argocd rollout status deployment/argocd-repo-server --timeout=600s
kubectl -n argocd rollout status statefulset/argocd-application-controller --timeout=600s

for _ in $(seq 1 60); do
  if kubectl -n argocd get secret argocd-initial-admin-secret > /dev/null 2>&1; then break; fi
  sleep 5
done
ARGO_PW="$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d)"
aws ssm put-parameter --name "${ssm_prefix}/argocd-admin-password" \
  --type SecureString --value "$ARGO_PW" --overwrite > /dev/null

# ---- 5. App-of-apps: ArgoCD now reconciles everything under gitops/apps from Git -----------
kubectl wait --for=condition=established --timeout=120s crd/applications.argoproj.io
kubectl apply -f - <<ROOTAPP
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: ${gitops_repo_url}
    targetRevision: ${gitops_revision}
    path: gitops/apps
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
ROOTAPP

touch /var/lib/lab-bootstrap.done
echo "[lab] bootstrap finished $(date -Is)"
